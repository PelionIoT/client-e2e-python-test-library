REPO=PelionIoT/client-e2e-python-test-library
KIND=tests
IMAGES=(
  "client-e2e-python-test-library|pre-nucloud|Dockerfile|.|-|-"
)
PLATFORM=linux/amd64
# The build fetches the private device simulator over the forwarded agent.
SSH=1
# scripts/nucloud-test.sh provisions a simulated device and runs tests/dev-client-tests.py.
TEST_CMD=(scripts/nucloud-test.sh)
SMOKE_CMD=(sh -c 'pytest --collect-only -q -p no:cacheprovider tests/dev-client-tests.py && manifest-dev-tool --version && echo smoke-ok')
