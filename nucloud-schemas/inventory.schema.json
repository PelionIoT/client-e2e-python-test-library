{
  "type": "object",
  "properties": {
    "schema": {
      "const": "trackhammer.inventory/v1"
    },
    "repo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "template": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "remote",
        "branch",
        "commit",
        "dirty",
        "template",
        "image"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "tags"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "default": {
            "type": "string",
            "enum": [
              "include",
              "exclude"
            ]
          },
          "source": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "listed": {
            "type": "boolean"
          }
        },
        "required": [
          "group",
          "description",
          "default",
          "source",
          "aliases",
          "listed"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "about": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "string"
        },
        "readme": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "tests",
        "readme",
        "framework",
        "fixtures"
      ],
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "state",
        "note"
      ],
      "additionalProperties": false
    },
    "template_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "at",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "repo",
    "cases",
    "vocabulary",
    "groups",
    "about"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
