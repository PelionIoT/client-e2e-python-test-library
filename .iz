# Stage placement for `make deploy MACHINE=<stage>`; stamped from IzumaNetworks/nucloud
# templates/iz, identical in every repo. izmachine reads global.iz, then this file,
# then the untracked .izlocal beside it; a later layer replaces an earlier one per machine.
# Private machines (k3s-cypress on cypressLinux) live in .izlocal.

[machine.k3s-ed]
provider  = "incus"
remote    = "D71"
kind      = "vm"
os        = "ubuntu"
osversion = "22.04"
image     = "images:ubuntu/jammy/cloud"

[machine.k3s-trav]
provider  = "incus"
remote    = "D71"
kind      = "vm"
os        = "ubuntu"
osversion = "22.04"
image     = "images:ubuntu/jammy/cloud"

# Production stage: listed under [nucloud] production below.
[machine.k3s-golden]
provider  = "incus"
remote    = "D71"
kind      = "vm"
os        = "ubuntu"
osversion = "22.04"
image     = "images:ubuntu/jammy/cloud"

# Stages nucloud never deploys to. Stage targets that change a stage (image-load,
# deploy, deploy-only) refuse these and leave them out of the picklist.
[nucloud]
production = ["k3s-golden"]
# Stages reached through their API alone, <stage>=<api url>: test repos run suites
# against them, and nucloud has no VM there to act on.
endpoints = ["staging=https://api.izuma.io"]
